# ==========================================================
# SmartNet - Backend Environment Configuration
# ==========================================================

PORT=5000
NODE_ENV=development

# MySQL Database Credentials
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_mysql_password_here
DATABASE_NAME=smartnet_db

# JWT Authentication Secret & Expiration
JWT_SECRET=smartnet_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173
